# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# This server's own public URL (admin panel and local uploads live here).
PUBLIC_BASE_URL=http://localhost:4000

# The public portfolio site(s), comma separated. The first one is used to
# preview covers stored on the site itself (paths like /media/...).
SITE_ORIGINS=http://localhost:3000

# Admin login. Create the hash with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters. Changing it signs everyone out.
SESSION_SECRET=

# Where videos, covers and the video list are stored:
# - "local": ./data on this machine (development only: most hosts wipe the
#   disk on redeploy)
# - "cloudinary": Cloudinary (covers are optimised automatically)
# - "s3": any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2)
STORAGE_DRIVER=local

# cloudinary driver only. Either paste the "API environment variable" from
# the Cloudinary dashboard (cloudinary://<api_key>:<api_secret>@<cloud_name>)...
CLOUDINARY_URL=
# ...or fill these three instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything this site uploads goes under this folder.
CLOUDINARY_FOLDER=portfolio

# s3 driver only.
# R2: https://<account-id>.r2.cloudflarestorage.com, leave empty for AWS.
S3_ENDPOINT=
# "auto" for R2, a region such as ap-south-1 for AWS.
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://media.example.com
S3_PUBLIC_URL=
